# Copy to .env and edit. Never commit .env. Values below are placeholders, not secrets.

# ---- Mode -------------------------------------------------------------------
# DEMO_MODE=true seeds clearly labelled MOCK projects. To run the fully offline deterministic demo ALSO set
# WEB_SEARCH_PROVIDER=demo and LLM_PROVIDER=demo (both are refused unless DEMO_MODE=true).
DEMO_MODE=false

# ---- Core -------------------------------------------------------------------
# REQUIRED in real use: a long random value (e.g. `openssl rand -hex 32`). Settings shows a warning while it is the default.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
POSTGRES_PASSWORD=atlas
# Set by docker-compose; override for local (non-docker) runs:
# DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
# REDIS_URL=redis://localhost:6379/0

# ---- Web / sessions ----------------------------------------------------------
CORS_ORIGINS=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8001
# Sessions are httpOnly cookies. Behind HTTPS set COOKIE_SECURE=true (required in production).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
API_RATE_LIMIT=600
LOG_LEVEL=INFO

# ---- Research engine --------------------------------------------------------
MAX_REPLANS=2
MAX_PARALLEL=4

# ---- LLM (OpenAI-compatible). Missing key => research fails with a clear error; it never falls back to demo data.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional: USD per 1K tokens. Unset => cost is shown as "Unavailable" (never guessed).
LLM_PRICE_INPUT_PER_1K=
LLM_PRICE_OUTPUT_PER_1K=

# ---- Web search ---------------------------------------------------------------
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_API_KEY=
